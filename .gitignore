# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.env

# SQLite local databases (auto-created on startup)
database/*.db
!database/.gitkeep

# Large precomputed models (auto-generated by running `python train.py`)
models/*.joblib
!models/.gitkeep

# Raw MovieLens data files (auto-downloaded by running `python get_data.py`)
data/*.zip
data/ratings.csv
data/movies.csv
data/links.csv
data/tags.csv
data/README.txt
!data/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
